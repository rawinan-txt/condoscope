{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "condoscope-api",
  "main": "src/index.ts",
  // workerd 1.20261104 is the newest runtime shipped with the installed wrangler
  "compatibility_date": "2026-11-04",
  "vars": { "ALLOWED_ORIGINS": "https://rawinan-txt.github.io" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "condoscope",
      // id from `wrangler d1 create condoscope`; an identifier, not a secret (the API token is what grants access)
      "database_id": "51398f2d-69bb-40b9-b376-4d3944089191",
      "migrations_dir": "../../database/migrations"
    }
  ]
}
