{
  "name": "condoscope",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "gen": "npx tsx packages/shared/scripts/write-fallback.ts && npx tsx packages/shared/scripts/write-seed.ts",
    "e2e": "npm run e2e -w web",
    "db:migrate": "npm run db:migrate -w api",
    "db:seed": "npm run db:seed -w api",
    "db:reset": "npm run db:reset -w api",
    "api:dev": "npm run dev -w api",
    "thumbnails": "node apps/web/scripts/capture-thumbnails.mjs",
    "typecheck": "tsc -p packages/shared && tsc -p apps/api && tsc -p apps/api/test && tsc -p apps/web --noEmit",
    "screenshots": "node apps/web/scripts/screenshots.mjs"
  },
  "devDependencies": {
    "yaml": "^2.9.1"
  }
}
